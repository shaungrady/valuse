{
	"name": "valuse",
	"version": "0.3.2",
	"description": "Reactive state that mirrors how you already think about data.",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "Shaun Grady",
		"email": "grady@shaungrady.com",
		"url": "https://shaungrady.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/shaungrady/valuse.git"
	},
	"homepage": "https://github.com/shaungrady/valuse#readme",
	"keywords": [
		"valuse",
		"reactive",
		"state",
		"state-management",
		"signals",
		"scope",
		"computed",
		"derivations",
		"observable",
		"typescript",
		"react",
		"svelte",
		"vue",
		"angular",
		"preact-signals"
	],
	"sideEffects": [
		"./dist/react.mjs"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./react": {
			"types": "./dist/react.d.mts",
			"import": "./dist/react.mjs"
		},
		"./svelte": {
			"types": "./dist/svelte.d.mts",
			"import": "./dist/svelte.mjs"
		},
		"./vue": {
			"types": "./dist/vue.d.mts",
			"import": "./dist/vue.mjs"
		},
		"./angular": {
			"types": "./dist/angular.d.mts",
			"import": "./dist/angular.mjs"
		},
		"./utils": {
			"types": "./dist/utils.d.mts",
			"import": "./dist/utils.mjs"
		},
		"./middleware": {
			"types": "./dist/middleware.d.mts",
			"import": "./dist/middleware.mjs"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"files": [
		"README.md",
		"dist"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"ci": "prettier --experimental-ternaries --check . && eslint . && tsc --noEmit && pnpm typecheck:examples && vitest run",
		"check": "prettier --experimental-ternaries --check . && eslint . && tsc --noEmit && pnpm typecheck:examples && vitest run && tsdown && knip && madge --circular --extensions mjs dist && publint",
		"check:fix": "prettier --experimental-ternaries --write . && eslint --fix . && tsc --noEmit && pnpm typecheck:examples && vitest run && tsdown && knip && madge --circular --extensions mjs dist && publint",
		"lint": "eslint --fix .",
		"format": "prettier --experimental-ternaries --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:types": "vitest --typecheck.only --run",
		"bench": "pnpm build && node --expose-gc bench/scope.mjs",
		"typecheck:examples": "tsc -p tsconfig.examples.json --noEmit",
		"analyze": "pnpm build && knip && madge --circular --extensions mjs dist && publint",
		"analyze:deadcode": "knip",
		"analyze:cycles": "madge --circular --extensions mjs dist",
		"analyze:publish": "publint",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "pnpm build && changeset publish",
		"prepack": "pnpm build"
	},
	"dependencies": {
		"@preact/signals-core": "^1.14.2"
	},
	"peerDependencies": {
		"@angular/core": ">=17",
		"@standard-schema/spec": ">=1",
		"react": ">=18",
		"svelte": ">=4",
		"vue": ">=3.5"
	},
	"peerDependenciesMeta": {
		"@angular/core": {
			"optional": true
		},
		"@standard-schema/spec": {
			"optional": true
		},
		"react": {
			"optional": true
		},
		"svelte": {
			"optional": true
		},
		"vue": {
			"optional": true
		}
	},
	"devDependencies": {
		"@angular/core": "^22.0.2",
		"@changesets/cli": "^2.29.8",
		"@eslint/js": "^9.39.4",
		"@standard-schema/spec": "^1.1.0",
		"@testing-library/react": "^16.3.2",
		"@types/react": "^19.2.14",
		"@vitest/coverage-v8": "^4.1.6",
		"arktype": "^2.2.0",
		"eslint": "^9.39.4",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jsdoc": "^62.9.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-sonarjs": "^4.0.3",
		"eslint-plugin-unicorn": "^64.0.0",
		"eslint-plugin-vitest": "^0.5.4",
		"expect-type": "^1.3.0",
		"fake-indexeddb": "^6.2.5",
		"jiti": "^2.7.0",
		"jotai": "^2.20.0",
		"jsdom": "^26.1.0",
		"knip": "^6.14.1",
		"lefthook": "^2.1.6",
		"madge": "^8.0.0",
		"mobx": "^6.16.1",
		"mobx-react-lite": "^4.1.1",
		"prettier": "^3.8.3",
		"publint": "^0.3.21",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"rxjs": "^7.8.2",
		"svelte": "^5.56.3",
		"tsdown": "^0.21.10",
		"type-fest": "^5.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.59.4",
		"valtio": "^2.3.2",
		"vitest": "^4.1.6",
		"vue": "^3.5.38",
		"zone.js": "^0.16.2",
		"zustand": "^5.0.14"
	},
	"packageManager": "pnpm@10.33.0",
	"volta": {
		"node": "24.16.0",
		"npm": "11.17.0"
	},
	"engines": {
		"node": ">=22"
	}
}
